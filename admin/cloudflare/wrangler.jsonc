{
  "name": "vav-owner",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/schema.mjs"] }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 * * * *"] },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "841001", "simple": { "limit": 6, "period": 60 } },
    { "name": "OWNER_LIMIT", "namespace_id": "841002", "simple": { "limit": 6, "period": 60 } },
    { "name": "INGEST_LIMIT", "namespace_id": "841003", "simple": { "limit": 4, "period": 60 } },
  ],
  "vars": { "ORIGIN": "https://vav-owner.kioqc.workers.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vav-owner-stats",
      "database_id": "dc5e195d-35a1-4ddc-9978-61d481e455e0",
      "migrations_dir": "migrations",
    },
  ],
}
