{
  "name": "vrc-avatar-vault",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:discord && npm run test:admin && npm run build",
    "release:version": "node scripts/version.mjs",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-update.ps1",
    "test:discord": "node --test scripts/tests/discord-post.check.mjs",
    "admin": "node admin/server.mjs",
    "test:admin": "node admin/cloudflare/prepare.mjs && node --test --test-isolation=none admin/server.check.mjs admin/cloudflare/worker.check.mjs",
    "admin:cloudflare:prepare": "node admin/cloudflare/prepare.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild-wasm": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
